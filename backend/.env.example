# 이 파일을 복사해서 backend/.env 를 만들고 값을 채우세요. (.env는 Git에 올라가지 않음)
# 비워 두면 개발용 기본값(SQLite 파일 backend/dev.db, backend/test.db)을 씁니다.

# 배포용 Neon 주소 예시 (앞부분을 postgresql+psycopg:// 로 바꿔서 넣기)
# DATABASE_URL=postgresql+psycopg://사용자:비밀번호@호스트/DB이름?sslmode=require
# DATABASE_URL_TEST=postgresql+psycopg://...(test 브랜치 주소)

# 허용할 화면 주소, 쉼표로 여러 개. 끝에 / 붙이지 않기
# 비워 두면 localhost와 127.0.0.1의 3000·3001번을 허용함
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
