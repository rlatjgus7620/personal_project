# 이 파일을 복사해서 backend/.env 를 만들고 값을 채우세요. (.env는 Git에 올라가지 않음)
# 비워 두면 개발용 기본값(SQLite 파일 backend/dev.db, backend/test.db)을 씁니다.

# 배포용 Neon 주소 예시 (앞부분을 postgresql+psycopg:// 로 바꿔서 넣기)
# DATABASE_URL=postgresql+psycopg://사용자:비밀번호@호스트/DB이름?sslmode=require
# DATABASE_URL_TEST=postgresql+psycopg://...(test 브랜치 주소)

# 허용할 화면 주소, 쉼표로 여러 개. 끝에 / 붙이지 않기
# 비워 두면 localhost와 127.0.0.1의 3000·3001번을 허용함
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- 관리자 로그인 (v2.0) ----------
# 로그인 비밀번호. 비워 두면 로그인이 안 됩니다. 남이 짐작하기 어려운 값으로 직접 정하세요.
# (이 예시 파일에는 진짜 비밀번호를 적지 말고, 복사한 backend/.env 에만 적기)
ADMIN_PASSWORD=
# 토큰 서명용 비밀 키. 비워 두면 서버를 켤 때마다 새로 만들어서, 서버를 다시 켜면 다시 로그인해야 합니다.
# 배포할 때는 꼭 긴 무작위 값을 넣으세요. 만드는 법: uv run python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# 로그인 유지 시간(시간 단위). 비우면 12
# TOKEN_HOURS=12
